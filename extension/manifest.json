{
  "manifest_version": 3,
  "name": "BridgeZone Tools",
  "version": "1.5.25",
  "description": "Xray, corrected aim, combat agent, and diagnostics for BridgeZone.",
  "action": {
    "default_title": "BridgeZone Tools",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dev-background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:43187/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bridgegame.ai/*",
        "https://bridgegame.ai/*"
      ],
      "js": [
        "loader.js",
        "bridgezone-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bridgegame.ai/*",
        "https://bridgegame.ai/*"
      ],
      "js": [
        "dev-revision.js",
        "dev-reload.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridgezone-main.js"
      ],
      "matches": [
        "https://www.bridgegame.ai/*",
        "https://bridgegame.ai/*"
      ]
    }
  ]
}
